`timescale 1ns / 10ps

// ============================================================
//  Testbench: mfhi R5
//
//  Instruction encoding (IR[31:27] = opcode, IR[26:23] = Ra):
//    mfhi R5  -> opcode TBD by student; Ra = 4'd5  -> IR[26:23] = 4'b0101
//
//  NOTE: mfhi does NOT use the ALU.  The execute step is
//        simply:  HIout, Gra, Rin   (one clock cycle).
//
//  Preloaded value:
//    HI  <- 32'hDEAD_BEEF
//
//  Expected result after simulation:
//    R5  == 32'hDEAD_BEEF   (mfhi R5)
// ============================================================

module mfhi_TB;

    // --------------------------------------------------------
    // DUT signal declarations
    // --------------------------------------------------------
    reg  PCout, Zlowout, Zhighout, MDRout, IRout, MARout;
    reg  HIout, LOout, InPortout, Cout;

    reg  MARin, Zlowin, Zhighin, PCin, MDRin, IRin, Yin;
    reg  HIin, LOin, InPortin, Cin, OutPortin, CONin;
    wire CON;

    reg  IncPC, read, write;
    reg  Gra, Grb, Grc;
    reg  Rin, Rout, BAout;

    reg  Clock, Clear;

    // --------------------------------------------------------
    // State encoding
    // --------------------------------------------------------
    parameter
        Default   = 5'd0,

        // ---- preload HI (put 0xDEADBEEF into HI register) ----
        PRE_HI    = 5'd1,

        // ---- mfhi R5 fetch ----
        T0        = 5'd2,
        T1        = 5'd3,
        T1b       = 5'd4,
        T2        = 5'd5,
        // ---- mfhi R5 execute ----
        T3        = 5'd6,
        T3_done   = 5'd7,

        DONE      = 5'd8;

    reg [4:0] Present_state = Default;

    // --------------------------------------------------------
    // DUT instantiation
    // --------------------------------------------------------
    DatapathP2 DUT (
        .clock      (Clock),      .clear      (Clear),
        .HIout      (HIout),      .LOout      (LOout),
        .Zhighout   (Zhighout),   .Zlowout    (Zlowout),
        .PCout      (PCout),      .MDRout     (MDRout),
        .InPortout  (InPortout),  .Cout       (Cout),
        .IRout      (IRout),      .MARout     (MARout),
        .OutPortout (1'b0),
        .HIin       (HIin),       .LOin       (LOin),
        .Zhighin    (Zhighin),    .Zlowin     (Zlowin),
        .PCin       (PCin),       .MDRin      (MDRin),
        .InPortin   (InPortin),   .Cin        (Cin),
        .IRin       (IRin),       .Yin        (Yin),
        .MARin      (MARin),      .OutPortin  (OutPortin),
        .CONin      (CONin),      .CON        (CON),
        .read       (read),       .write      (write),
        .IncPC      (IncPC),
        .Gra        (Gra),        .Grb        (Grb),        .Grc   (Grc),
        .Rin        (Rin),        .Rout       (Rout),       .BAout (BAout)
    );

    // --------------------------------------------------------
    // Clock  (20 ns period)
    // --------------------------------------------------------
    initial begin
        Clock = 0;
        forever #10 Clock = ~Clock;
    end

    // --------------------------------------------------------
    // State sequencer
    // --------------------------------------------------------
    always @(posedge Clock) begin
        case (Present_state)
            Default   : Present_state <= PRE_HI;
            PRE_HI    : Present_state <= T0;

            T0        : Present_state <= T1;
            T1        : Present_state <= T1b;
            T1b       : Present_state <= T2;
            T2        : Present_state <= T3;
            T3        : Present_state <= T3_done;
            T3_done   : Present_state <= DONE;

            DONE      : Present_state <= DONE;
        endcase
    end

    // --------------------------------------------------------
    // Helper task: clear every control line to 0
    // --------------------------------------------------------
    task all_zero;
    begin
        PCout<=0; Zlowout<=0; Zhighout<=0; MDRout<=0;
        IRout<=0; MARout<=0;  HIout<=0;    LOout<=0;
        InPortout<=0; Cout<=0;
        MARin<=0;  Zlowin<=0; Zhighin<=0; PCin<=0;
        MDRin<=0;  IRin<=0;   Yin<=0;     HIin<=0;
        LOin<=0;   InPortin<=0; Cin<=0;   OutPortin<=0;
        CONin<=0;  IncPC<=0;  read<=0;    write<=0;
        Gra<=0;    Grb<=0;    Grc<=0;
        Rin<=0;    Rout<=0;   BAout<=0;
    end
    endtask

    // --------------------------------------------------------
    // Control logic
    // --------------------------------------------------------
    always @(Present_state) begin
        case (Present_state)

            // ==================================================
            // RESET / DEFAULT
            // ==================================================
            Default: begin
                Clear <= 1;
                all_zero;
            end

            // ==================================================
            // PRELOAD HI <- 32'hDEAD_BEEF
            // ==================================================
            PRE_HI: begin
                all_zero;
                Clear <= 0;
                force DUT.BusMuxOut = 32'hDEAD_BEEF;
                HIin <= 1;
            end

            // ==================================================
            // mfhi R5  —  FETCH  (T0 / T1 / T1b / T2)
            //
            // RAM[0] must contain the mfhi R5 encoding.
            // IR[31:27] = your mfhi opcode
            // IR[26:23] = 4'b0101  (R5)
            //
            // Edit the line below to match your opcode assignment:
            //   e.g. if mfhi opcode = 5'b10011:
            //   RAM1[0] = 32'b10011_0101_0000000000000000000000;
            //           = 32'h9A000000
            // ==================================================
            T0: begin
                release DUT.BusMuxOut;   // release HI force
                all_zero;
                // T0: PC -> MAR, IncPC
                PCout <= 1; MARin <= 1; IncPC <= 1;
            end

            T1: begin
                all_zero;
                // T1: initiate memory read
                read <= 1; MDRin <= 1;
            end

            T1b: begin
                // hold read high one extra cycle (RAM latency)
                read <= 1; MDRin <= 1;
            end

            T2: begin
                all_zero;
                // T2: MDR -> IR
                MDRout <= 1; IRin <= 1;
            end

            // ==================================================
            // mfhi R5  —  EXECUTE  (T3)
            //
            // RTL:  R5 <- HI
            // HIout puts HI onto the bus.
            // Gra selects Ra field (IR[26:23] = 0101 = R5).
            // Rin latches the bus value into R5.
            // ==================================================
            T3: begin
                all_zero;
                HIout <= 1;   // HI -> bus
                Gra   <= 1;   // select Ra (R5) from IR
                Rin   <= 1;   // R5 <- bus
            end

            T3_done: begin
                all_zero;
                // R5 has now latched HI (0xDEADBEEF)
                $display("=== mfhi R5 ===");
                $display("HI preloaded : 0xDEADBEEF");
                $display("R5 after mfhi: 0x%08h", DUT.BusMuxInR5);
                if (DUT.BusMuxInR5 === 32'hDEAD_BEEF)
                    $display("PASS: R5 == 0xDEADBEEF");
                else
                    $display("FAIL: R5 = 0x%08h (expected 0xDEADBEEF)", DUT.BusMuxInR5);
            end

            DONE: begin
                all_zero;
                $display("-------------------------------");
                $display("Simulation complete.");
            end

        endcase
    end

endmodule